<?xml version="1.0" encoding="utf-8"?>
<!-- The Dimmers widget in the picker -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_card" android:tint="#1E1E1E" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="10dp" android:src="@drawable/wi_bulb" android:tint="#D98A4E" />
            <TextView style="@style/WgText.Bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:singleLine="false" android:text="Floor lamp" android:textColor="#FFFFFF" android:textSize="14sp" />
            <TextView style="@style/WgText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="60%" android:textColor="#9E9E9E" android:textSize="13sp" />
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wg_dot" android:tint="#D98A4E" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/wi_power" android:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="10dp" android:src="@drawable/wi_grid" android:tint="#9E9E9E" />
            <TextView style="@style/WgText.Bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:singleLine="false" android:text="Kitchen" android:textColor="#FFFFFF" android:textSize="14sp" />
            <TextView style="@style/WgText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Off" android:textColor="#9E9E9E" android:textSize="13sp" />
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wg_dot" android:tint="#2B2B2B" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/wi_power" android:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="10dp" android:src="@drawable/wi_grid" android:tint="#D98A4E" />
            <TextView style="@style/WgText.Bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:singleLine="false" android:text="Primary bedroom closet" android:textColor="#FFFFFF" android:textSize="14sp" />
            <TextView style="@style/WgText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="40%" android:textColor="#9E9E9E" android:textSize="13sp" />
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wg_dot" android:tint="#D98A4E" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/wi_power" android:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
