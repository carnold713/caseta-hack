<?xml version="1.0" encoding="utf-8"?>
<!-- One colour in the Colours widget: a round swatch, a ring round the one the lamp is showing -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_sw"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/wg_sw_ring"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/wg_ring"
        android:visibility="invisible"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/wg_sw_dot"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:src="@drawable/wg_dot"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/wg_sw_ic"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="center"
        android:src="@drawable/wi_power"
        android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>
