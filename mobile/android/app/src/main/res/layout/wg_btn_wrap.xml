<?xml version="1.0" encoding="utf-8"?>
<!-- A button as wide as its words (All off): a pill, tinted by the code -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_btn"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:minWidth="96dp">

    <ImageView
        android:id="@+id/wg_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_pill"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/wg_btn_ic"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/wi_power"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/wg_btn_tx"
            style="@style/WgText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
