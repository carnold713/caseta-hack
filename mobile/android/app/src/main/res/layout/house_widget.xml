<?xml version="1.0" encoding="utf-8"?>
<!-- The house on the home screen (HouseWidget): the headline as Home's whole-house card says it, one line under it,
     and All off. A tap anywhere but the button opens the app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/w_glow"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-120dp"
        android:layout_marginEnd="-90dp"
        android:src="@drawable/widget_glow"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHOLE HOUSE"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your home"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:fontFamily="sans-serif-light"
            android:maxLines="1" />

        <TextView
            android:id="@+id/w_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap to open"
            android:textColor="#D1D1D1"
            android:textSize="14sp"
            android:maxLines="1" />

        <!-- a widget may only hold the views RemoteViews knows, so the gap is an empty FrameLayout, not a Space -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/w_off"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/widget_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="22dp"
            android:contentDescription="All off">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_power_dark"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="All off"
                android:textColor="#262626"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
