<?xml version="1.0" encoding="utf-8"?>
<!-- A widget's heading: its icon, what it is, one line under it (with a countdown while a timer runs), and a
     round power button at the end when it has one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_head"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/wg_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/wi_bulb"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/wg_words"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wg_title"
            style="@style/WgText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/wg_chrono"
                style="@style/WgText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="#D98A4E"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wg_sub"
                style="@style/WgText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9E9E9E"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/wg_pwr"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/wg_pwr_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/wg_dot"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/wg_pwr_ic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/wi_power"
            android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
