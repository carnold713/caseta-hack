<?xml version="1.0" encoding="utf-8"?>
<!-- wg_dim_row for a Dimmers widget with room to spare: larger words and a larger button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_dim"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/wg_dim_ic"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/wi_bulb"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/wg_dim_name"
        style="@style/WgText.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2"
        android:singleLine="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/wg_dim_lv"
        style="@style/WgText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#9E9E9E"
        android:textSize="15sp" />

    <FrameLayout
        android:id="@+id/wg_dim_pwr"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="14dp">

        <ImageView
            android:id="@+id/wg_dim_pwr_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/wg_dot"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/wg_dim_pwr_ic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/wi_power"
            android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
