<?xml version="1.0" encoding="utf-8"?>
<!-- One segment of a Dimmers row's brightness bar: a tap sets its level. The code pads it, so the strip is tall to
     tap and thin to see, with a small gap to the next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_seg"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/wg_seg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_seg"
        android:importantForAccessibility="no" />
</FrameLayout>
