<?xml version="1.0" encoding="utf-8"?>
<!-- The Light widget in the picker: a lit lamp fills the card with its colour -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_card" android:tint="#D98A4E" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="10dp" android:src="@drawable/wi_bulb" android:tint="#FFFFFF" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView style="@style/WgText.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reading lamp" android:textColor="#FFFFFF" android:textSize="15sp" /><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal"><TextView style="@style/WgText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="70% · Amber" android:textColor="#9E9E9E" android:textSize="13sp" /></LinearLayout></LinearLayout><FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp">
          <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wg_dot" android:tint="#FFFFFF" />
          <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/wi_power" android:tint="#9C5A2A" /></FrameLayout></LinearLayout><FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
