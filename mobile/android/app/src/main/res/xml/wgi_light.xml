<?xml version="1.0" encoding="utf-8"?>
<!-- The light widget (Widgets.java). Resizable both ways; laid out for each size it is shown at. Android refreshes it
     every 30 minutes, the widgets read the hub every 15 (WidgetRefreshJob), and the app hands it every change while
     open. Its page in the app (#widgets/id) opens when it is placed and edits it live. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/wg_loading"
    android:previewLayout="@layout/wgp_light"
    android:previewImage="@drawable/wgp_light"
    android:description="@string/wg_light_d"
    android:configure="app.caseta.home.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen" />
