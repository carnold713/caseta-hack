<?xml version="1.0" encoding="utf-8"?>
<!-- The Dimmers widget (Widgets.java): what is pinned on Home, each with a brightness bar and a power button.
     Resizable both ways; laid out for each size it is shown at. Android refreshes it every 30 minutes, the widgets
     read the hub every 15 (WidgetRefreshJob), and the app hands it every change while open. Its page in the app
     (#widgets/id) opens when it is placed (or later, from a long press) and edits it live. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="90dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/wg_loading"
    android:previewLayout="@layout/wgp_dimmers"
    android:previewImage="@drawable/wgp_dimmers"
    android:description="@string/wg_dimmers_d"
    android:configure="app.caseta.home.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:widgetCategory="home_screen" />
