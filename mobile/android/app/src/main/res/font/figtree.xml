<?xml version="1.0" encoding="utf-8"?>
<!-- Figtree, the app's font (mobile/www/font), for the widgets on Android 12 and later (values-v31/styles.xml).
     One variable file, held at the two weights the widgets use. Licence: mobile/www/font/OFL.txt -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/figtree_var" android:fontStyle="normal" android:fontWeight="400" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/figtree_var" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 640" />
</font-family>
