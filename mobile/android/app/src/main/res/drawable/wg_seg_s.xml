<?xml version="1.0" encoding="utf-8"?>
<!-- The first segment of a Dimmers row's bar, round at its outer end so the bar reads as the app's slider. Android
     scales corners that are too large for the height down together, so 8dp is a full round end at any bar height. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners
        android:topLeftRadius="8dp"
        android:bottomLeftRadius="8dp"
        android:topRightRadius="3dp"
        android:bottomRightRadius="3dp" />
</shape>
