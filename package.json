{
  "name": "caseta-hack",
  "version": "0.1.0",
  "description": "Pico remote superpowers for Lutron Caseta: a Railway-hosted hub + PWA and a small local agent that talks LEAP to the Smart Bridge.",
  "private": true,
  "main": "hub/server.js",
  "scripts": {
    "start": "node hub/server.js",
    "dev": "APP_PASSWORD=dev AGENT_TOKEN=dev node hub/server.js",
    "icons": "node scripts/make-icons.js",
    "test": "node --test \"hub/**/*.test.js\" \"scripts/**/*.test.js\"",
    "tint-check": "node scripts/tint-check.js",
    "test:browser": "node test/browser/run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
