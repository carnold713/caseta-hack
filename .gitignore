node_modules/
# the hub's local store (hub/store.js DATA_DIR defaults to <repo>/data). Anchored: unanchored, it also
# swallowed web/data (the app's data layer) and test/data, and the app would have deployed without them.
/data/
agent/data/
agent/.venv/
agent/__pycache__/
*.pyc
.env
.DS_Store
.claude/

# screenshots and scratch output from a test run: never project content
scratchpad/

# a browser test writing beside itself: run.js puts a run's cwd in a temp directory, but a test run by
# hand from test/browser drops its screenshots and logs here
test/browser/*.png
test/browser/*.log
test/browser/*.pid
test/browser/*token*.txt

# the component gallery's rendered check shot, regenerated on demand
web/ui/gallery.png
